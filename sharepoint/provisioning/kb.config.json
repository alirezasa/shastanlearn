{
  "SiteUrl": "https://learn.shastan.ir",
  "Zone": "Auto",
  "EnableAnonymousOnWebApplication": true,
  "EnableLockdownMode": true,
  "SetWelcomePage": true,

  "ContentList": "KnowledgeContent",
